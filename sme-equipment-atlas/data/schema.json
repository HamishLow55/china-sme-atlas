  "x-atlas-metric-dimensions": {
    "registry": "metrics",
    "lookup_field": "metric_id",
    "schema_field": "dimension_schema",
    "value_field": "dimensions"
  },
  "$defs": {
    "process_node_fields": {
      "type": "object",
      "properties": {
        "process_node": {
          "type": "string",
          "minLength": 1,
          "description": "Exact source-native numerical/named node expression including bounds and exclusions; never infer from advanced-process prose."
        },
        "process_node_context": {
          "type": "string",
          "minLength": 1,
          "description": "Exact source-native device/process context, or not_stated when absent."
        }
      },
      "required": [
        "process_node",
        "process_node_context"
      ],
      "additionalProperties": false
    }
  },
  "x-atlas-node-claims": {
    "fields_schema": "#/$defs/process_node_fields",
    "observation_location": "dimensions",
    "platform_locations": [
      "evidence",
      "maturity_history"
    ],
    "numeric_scope_rule": "A node on a numeric observation must qualify that measurement, not adjacent capability prose.",
    "measurement_scope_field": "node_scope"
  },
  "x-atlas-percent-semantics": {
    "metric_field": "percent_semantics",
    "unit": "percent",
    "default_maximum": "100",
    "unbounded_values": [
      "relative_change",
      "unbounded_ratio"
    ]
  },
  "x-atlas-source-decrease": {
    "metric_flag": "allow_source_decrease"
  },
  "x-atlas-source-loss": {
    "metric_flag": "allow_source_loss"
  },
  "x-atlas-platform-maturity-date": {
    "legacy_default": "legacy_unspecified",
    "allowed_bases": [
      "legacy_unspecified",
      "source_stated_date",
      "source_report_context"
    ],
    "undated_basis": "source_report_context",
    "description": "Report-context history retains source_id and empty as_of; no event date is inferred. Existing dated records without date_basis retain legacy interpretation, not retroactive source-date verification."
  }
}